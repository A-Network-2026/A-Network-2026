{
  "name": "anet-swap-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "AnetSwap EVM bridge smart contracts for A Network",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:bsc": "hardhat run scripts/deploy.js --network bsc",
    "deploy:bsc-testnet": "hardhat run scripts/deploy.js --network bsc_testnet",
    "deploy:eth": "hardhat run scripts/deploy.js --network eth",
    "deploy:l2portal:bsc": "hardhat run scripts/deploy-l2-portal.js --network bsc",
    "deploy:l2portal:bsc-testnet": "hardhat run scripts/deploy-l2-portal.js --network bsc_testnet",
    "deploy:feeproc:bsc": "hardhat run scripts/deploy-fee-processor.js --network bsc",
    "deploy:feeproc:bsc-testnet": "hardhat run scripts/deploy-fee-processor.js --network bsc_testnet",
    "deploy:mintburn:eth": "hardhat run scripts/deploy-mint-burn-portal.js --network eth",
    "deploy:mintburn:bsc": "hardhat run scripts/deploy-mint-burn-portal.js --network bsc",
    "deploy:mintburn:bsc-testnet": "hardhat run scripts/deploy-mint-burn-portal.js --network bsc_testnet",
    "deploy:mintburn:sepolia": "hardhat run scripts/deploy-mint-burn-portal.js --network sepolia",
    "setup:bsc": "hardhat run scripts/setup-tokens.js --network bsc",
    "verify:bsc": "hardhat verify --network bsc"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.6.1",
    "hardhat": "^2.22.5"
  }
}
