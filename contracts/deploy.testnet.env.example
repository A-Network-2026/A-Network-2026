# ─────────────────────────────────────────────────────────────────────────────
# TESTNET deploy config for the ANET mint/burn bridge (BSC testnet + Sepolia).
# Copy to `.env` in this folder and fill in. This is a DRY RUN with test tokens —
# no real value. Do the full round-trip here before even discussing mainnet.
#
# RUNBOOK (per spoke chain):
#   1. Fund a fresh deployer key with testnet gas:
#        BSC testnet faucet:  https://testnet.bnbchain.org/faucet-smart
#        Sepolia faucet:      https://sepoliafaucet.com  (or Alchemy/Infura faucet)
#   2. Fill the vars below, then:
#        npm run deploy:mintburn:bsc-testnet     # deploys WrappedANET + portal on BSC testnet
#        npm run deploy:mintburn:sepolia         # deploys the same on Sepolia
#   3. Note the printed WrappedANET + portal addresses; the wANET admin (Safe)
#      must call wANET.acceptAdmin() on each chain.
#   4. Configure bridge-relayer/.env with those portal/wANET addresses + the
#      signer set, and run ROLE=reconciler / ROLE=signer / ROLE=submitter.
#   5. Test the round-trip: L1 lock (POST /bridge/x/lock) → relayer mints on the
#      spoke → burn on the spoke (bridgeOut) → relayer credits back on L1.
# ─────────────────────────────────────────────────────────────────────────────

# Per-chain deployer keys (NEVER reuse mainnet keys; fresh testnet keys only).
DEPLOYER_PRIVATE_KEY_BSC_TESTNET=0x_your_bsc_testnet_deployer_key
DEPLOYER_PRIVATE_KEY_SEPOLIA=0x_your_sepolia_deployer_key

# Ethereum testnet RPC (Infura/Alchemy key or a public Sepolia RPC)
INFURA_API_KEY=
SEPOLIA_RPC_URL=

# ── Portal deploy parameters (used by deploy-mint-burn-portal.js) ────────────
# On testnet you can use the deployer / an EOA for these; on mainnet they MUST
# be Gnosis Safes.
PORTAL_ADMIN=0x_admin_or_safe
WANET_ADMIN=0x_wanet_admin_or_safe
PORTAL_PAUSER=0x_separate_pauser_key

# M-of-N relayer signer addresses (comma-separated) + threshold. For a real
# test use 3 independent keys with threshold 2.
PORTAL_SIGNERS=0xSigner1,0xSigner2,0xSigner3
PORTAL_THRESHOLD=2

# Rolling caps in whole wANET (per-tx <= per-recipient-24h <= global-24h).
PORTAL_MAX_PER_TX=1000
PORTAL_MAX_RECIP_24H=5000
PORTAL_MAX_GLOBAL_24H=50000

# Block-explorer verification (optional on testnet)
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=
