# ── ANET multi-chain bridge relayer ──────────────────────────────────────────
# ROLE: signer | submitter | reconciler
ROLE=reconciler

# L1 hub
ANET_L1_BASE_URL=https://explorer.a-network.net
L1_HUB_CHAIN_ID=999

# M-of-N signer identity (required for signer/submitter). ONE key per operator.
# SIGNER_PRIVATE_KEY=0x...

# Scan / poll tuning
SCAN_CHUNK_BLOCKS=2000
POLL_INTERVAL_MS=5000
RECONCILE_INTERVAL_MS=60000
ATTESTATION_TTL_SECS=3600

# ── Spokes (modular — add a chain by appending its id here + an env block) ────
SPOKES=eth,bsc

# Ethereum spoke
SPOKE_ETH_RPC_URL=https://rpc.ankr.com/eth/<KEY>
SPOKE_ETH_CHAIN_ID=1
SPOKE_ETH_PORTAL=0x0000000000000000000000000000000000000000
SPOKE_ETH_WANET=0x0000000000000000000000000000000000000000
SPOKE_ETH_START_BLOCK=0
SPOKE_ETH_MIN_CONFIRMATIONS=12

# BNB Smart Chain spoke
SPOKE_BSC_RPC_URL=https://rpc.ankr.com/bsc/<KEY>
SPOKE_BSC_CHAIN_ID=56
SPOKE_BSC_PORTAL=0x0000000000000000000000000000000000000000
SPOKE_BSC_WANET=0x0000000000000000000000000000000000000000
SPOKE_BSC_START_BLOCK=0
SPOKE_BSC_MIN_CONFIRMATIONS=15
