# ── ANET multi-chain bridge relayer — production config ──────────────────────
# ROLE: signer | submitter | solana | reconciler
#   signer     one M-of-N operator: attests L1→spoke locks AND posts native-ANET
#              spoke→L1 credits. Holds ONE key; cannot move funds alone.
#   submitter  aggregates ≥threshold sigs → portal.bridgeIn on the spoke (pays gas).
#   solana     signer+submitter for the Solana spoke (see [Solana] block).
#   reconciler read-only supply-integrity monitor (default).
ROLE=reconciler

# ── L1 hub ───────────────────────────────────────────────────────────────────
ANET_L1_BASE_URL=https://explorer.a-network.net
L1_HUB_CHAIN_ID=999
# The L1 chain_id STRING bound into native-ANET action signatures (credit dir).
ANET_L1_CHAIN_ID=anet-private-mainnet-1

# ── Signer identity (M-of-N) ─────────────────────────────────────────────────
# EVM secp256k1 key: signs EIP-712 bridgeIn attestations for every spoke.
# SIGNER_PRIVATE_KEY=0x...
# Native-ANET secp256k1 key for spoke→L1 credit attestations (its derived ANET
# address must be in the node's ANET_PORTAL_SIGNERS). CAN be the same key as
# SIGNER_PRIVATE_KEY (one key → one EVM addr + one ANET addr).
# ANET_PORTAL_SIGNER_KEY=0x...

# ── Scan / poll tuning ───────────────────────────────────────────────────────
SCAN_CHUNK_BLOCKS=2000
POLL_INTERVAL_MS=5000
RECONCILE_INTERVAL_MS=60000
ATTESTATION_TTL_SECS=3600

# ── Spokes (modular — add a chain by appending its id here + an env block) ────
SPOKES=eth,bsc

# Ethereum spoke
SPOKE_ETH_RPC_URL=https://rpc.ankr.com/eth/<KEY>
SPOKE_ETH_CHAIN_ID=1
SPOKE_ETH_PORTAL=0x0000000000000000000000000000000000000000
SPOKE_ETH_WANET=0x0000000000000000000000000000000000000000
SPOKE_ETH_START_BLOCK=0
SPOKE_ETH_MIN_CONFIRMATIONS=12

# BNB Smart Chain spoke
SPOKE_BSC_RPC_URL=https://rpc.ankr.com/bsc/<KEY>
SPOKE_BSC_CHAIN_ID=56
SPOKE_BSC_PORTAL=0x0000000000000000000000000000000000000000
SPOKE_BSC_WANET=0x0000000000000000000000000000000000000000
SPOKE_BSC_START_BLOCK=0
SPOKE_BSC_MIN_CONFIRMATIONS=15

# ── Solana spoke (optional; only read when SOLANA_ENABLED is truthy) ──────────
# Requires: npm i @solana/web3.js @coral-xyz/anchor
SOLANA_ENABLED=0
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PROGRAM_ID=
# IDL produced by `anchor build` (target/idl/anet_portal.json)
SOLANA_IDL_PATH=../solana/target/idl/anet_portal.json
# Keypair that pays for + submits mint txs (submitter only; omit for pure signer)
SOLANA_WALLET_KEYPAIR=/absolute/path/to/solana-keypair.json
# Synthetic EIP-712 domain values bound into the program at initialize()
SOLANA_EIP712_CHAIN_ID=1399811149
SOLANA_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000
# Resume point for BridgeOut scanning (a tx signature); omit to start from head
SOLANA_START_SIGNATURE=
SOLANA_MIN_CONFIRMATIONS=31
